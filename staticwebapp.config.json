{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",

  "routes": [
    {
      "route": "/.auth/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/*",
      "allowedRoles": ["stfc_operator"]
    },
    {
      "route": "/*",
      "allowedRoles": ["stfc_operator"]
    }
  ],

  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/github?post_login_redirect_uri=/",
      "statusCode": 302
    },
    "403": {
      "rewrite": "/403.html",
      "statusCode": 403
    }
  },

  "auth": {
    "identityProviders": {
      "github": {
        "registration": {
          "clientIdSettingName": "GITHUB_OAUTH_CLIENT_ID",
          "clientSecretSettingName": "GITHUB_OAUTH_CLIENT_SECRET"
        }
      }
    }
  },

  "globalHeaders": {
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },

  "mimeTypes": {
    ".json": "application/json"
  },

  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/*.{css,js,png,jpg,svg,ico,woff2,map,json}"]
  },

  "platform": {
    "apiRuntime": "node:22"
  }
}
