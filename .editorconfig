# https://editorconfig.org
# Git tracks LF line endings via .gitattributes (`* text=auto eol=lf`); Windows
# checkouts with core.autocrlf=true may materialize CRLF in the working tree.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
