name: Squad Insider Release

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - name: Require main
        run: |
          if [ "$GITHUB_REF" != "refs/heads/main" ]; then
            echo "::error::Insider releases must be dispatched from main."
            exit 1
          fi
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version-file: .nvmrc
          cache: npm
      - run: npm ci
      - run: npm ci
        working-directory: api
      - run: npm ci
        working-directory: web
      - run: npm ci
        working-directory: pwa-browser
      - run: npm ci
        working-directory: pwa-token-api
      - run: npm run typecheck
      - run: npm test
      - name: Tag and publish insider release
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          VERSION=$(node -p "require('./package.json').version")
          TAG="v${VERSION}-insider.${GITHUB_RUN_ID}"
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git tag -a "$TAG" "$GITHUB_SHA" -m "Insider release $TAG"
          git push origin "$TAG"
          gh release create "$TAG" --verify-tag --prerelease \
            --title "$TAG" --notes "Insider preview from commit $GITHUB_SHA."
